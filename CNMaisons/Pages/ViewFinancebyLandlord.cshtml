@page
@model CNMaisons.Pages.ViewFinancebyLandlordModel
@{
    ViewData["Title"] = "Financial Report";
    var currentYear = DateTime.Now.Year;
}

<div class="container">
    <h1 class="section-title">Financial report</h1>

    <form name="ViewPayment" method="post" class="transition-fade-down">
        <fieldset>
            <legend>Select a year range</legend>
            <div class="form-grid">
                <div class="field">
                    <label for="FindStartYear">From Year</label>
                    <select id="FindStartYear" name="FindStartYear" required>
                        <option value="">Select Year</option>
                        @for (int year = currentYear; year <= (currentYear + 5); year++)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="FindEndYear">To Year</label>
                    <select id="FindEndYear" name="FindEndYear" required>
                        <option value="">Select Year</option>
                        @for (int year = currentYear; year <= (currentYear + 5); year++)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
            </div>
            <input type="submit" name="Submit" value="FindRecords" class="btn" />
        </fieldset>
    </form>

    @if (Model.ViewPage == true)
    {
        <form name="ShowFincialRecord" method="post">
            @{
                var sections = new (string legend, IEnumerable<dynamic> rows)[]
                {
                    ("Financial Records made within the selected Years", Model.FinancialRecordList),
                    ("Financial Records Due within 3 Months", Model.FinancialRecordDSueThreeMonthsList),
                    ("Financial Records Due within 6 Months", Model.FinancialRecordDSueSixMonthsList),
                };
            }
            @foreach (var sec in sections)
            {
                <fieldset>
                    <legend>@sec.legend</legend>
                    <div class="table-div">
                        <table>
                            <thead>
                                <tr>
                                    <th>Tenant ID</th><th>Property ID</th><th>Date of Record</th><th>Amount Paid</th>
                                    <th>Pay Period</th><th>Next Due Date</th><th>Date of Payment</th><th>Method</th><th>Bank</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in sec.rows)
                                {
                                    <tr>
                                        <td>@record.TenantID</td>
                                        <td>@record.PropertyID</td>
                                        <td>@record.DateOfRecord.ToString("dd MMM yyyy")</td>
                                        <td>@record.AmountPaid.ToString("0.00")</td>
                                        <td>@record.PaymentStartMonth (@record.PaymentStartYear) - @record.PaymentEndMonth</td>
                                        <td>@record.NextDueDate.ToString("dd MMM yyyy")</td>
                                        <td>@record.DateOfTenantsPayment.ToString("dd MMM yyyy")</td>
                                        <td>@record.MethodOfPayment</td>
                                        <td>@record.TenantPaymentBank</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </fieldset>
            }
            <input type="submit" name="Submit" value="Close" class="btn" />
        </form>
    }
</div>

@page
@model CNMaisons.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}
<div class="auth">
    @if (Model.RequestCode == true)
    {
        <form name="Login" method="post" class="auth-card">
            <fieldset>
                <legend>Forgot password</legend>
                <p class="@Model.AlertClass">@Model.Message</p>
                <label for="Email">Email</label>
                <input type="email" id="Email" name="Email" required />
                <input type="submit" name="Submit" value="Send Code" class="btn" />
                <div class="auth-links">
                    <a href="~/Login">Back to login</a>
                </div>
            </fieldset>
        </form>
    }

    @if (Model.CodeSent == true)
    {
        <form name="Token" method="post" class="auth-card">
            <fieldset>
                <legend>Enter the code</legend>
                <p class="@Model.AlertClass">@Model.Message</p>
                <label for="InputedToken">Token</label>
                <input type="text" id="InputedToken" name="InputedToken" required />
                <input type="submit" name="Submit" value="Confirm" class="btn" />
            </fieldset>
        </form>
    }

    @if (Model.CorrectcodeInput == true)
    {
        <form name="PasswordReset" method="post" class="auth-card">
            <fieldset>
                <legend>Set a new password</legend>
                <p class="@Model.AlertClass">@Model.Message</p>
                <label for="Password">New password</label>
                <input type="password" id="Password" name="Password" required>
                @Html.ValidationMessage("PasswordError")
                <label for="PasswordConfirm">Re-enter password</label>
                <input type="password" id="PasswordConfirm" name="PasswordConfirm" required>
                @Html.ValidationMessage("ConfirmPasswordError")
                @Html.ValidationMessage("PasswordMatchError")
                <input type="submit" name="Submit" value="Update Password" class="btn">
            </fieldset>
        </form>
    }
</div>

@page
@model CNMaisons.Pages.ForgotPasswordModel
@{
    Layout = "_Header";
    ViewData["Title"] = "Login";
}
<div class="login_page">
   @*  <video autoplay muted loop id="video-background">
        <source src="~/img/login.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video> *@
    @if (Model.RequestCode == true)
    {
        <form name="Login" method="post" class="form loginForm">
            <fieldset>
                <p class="@Model.AlertClass">@Model.Message</p>
                <legend>Forgot Password</legend>
                <label for="Email">Email</label>
                <br />
                <input type="email" name="Email" required />
                <br />
                <input type="submit" name="Submit" value="Login" class="btn" />
            </fieldset>
        </form>
    }
   
    @if (Model.CodeSent == true)
    {
        <form name="Token" method="post" class="form loginForm ">
            <fieldset>
                <p class="@Model.AlertClass">@Model.Message</p>
                <legend>Input The Code</legend>
                <label for="Token">Token</label>
                <br />
                <input type="text" name="InputedToken" required />
                <br />
                <input type="submit" name="Submit" value="Confirm" class="btn" />
            </fieldset>
        </form>
    }
    
    @if (Model.CorrectcodeInput == true)
    {
        <form name="PasswordReset" method="post" class="form loginForm ">
            <fieldset>
                <p class="@Model.AlertClass">@Model.Message</p>
                <legend>Enter Your New Password </legend>
                <label for="Password">New Password</label>
                <br />
                <input type="password" name="Password" required>
                <br />
                @Html.ValidationMessage("PasswordError")
                <label for="PasswordConfirm">Re-enter Password</label>
                <br />
                <input type="password" name="PasswordConfirm" required>
                <br />
                @Html.ValidationMessage("ConfirmPasswordError")
                @Html.ValidationMessage("PasswordMatchError")
                <input type="submit" name="Submit" value="Update Password">
            </fieldset>
        </form>
    }
</div>
@page
@model CNMaisons.Pages.LeaseApplicationModel
@{
    ViewData["Title"] = "Lease Application";
    var emailPattern = new System.Text.RegularExpressions.Regex(@"^[^\s@]+@[^\s@]+\.[^\s@]+$");
}

<script src="~/libraries/jquery/jquery.js"></script>
<script src="~/libraries/jquery-validate/jquery.validate.js"></script>
<script src="~/libraries/jquery-validate-unobtrusive/jquery.validate.unobtrusive.js"></script>

<script type="text/javascript">
    // Toggle self-employed vs employer detail sections.
    function showFields() {
        document.getElementById("selfEmployedFields").style.display = "block";
        document.getElementById("employerFields").style.display = "none";
    }
    function hideFields() {
        document.getElementById("selfEmployedFields").style.display = "none";
        document.getElementById("employerFields").style.display = "block";
    }
    // Toggle spouse details when marital status is Married.
    function toggleSpouseFields(select) {
        var spouseFields = document.getElementById("spouseFields");
        spouseFields.style.display = (select.value === "Married") ? "block" : "none";
    }
</script>

<div class="container">
    <h1 class="section-title">Lease application</h1>

    @foreach (var error in Model.errorMessage)
    {
        @if (error != null)
        {
            <p class="alert alert--danger">@error</p>
        }
    }
    @if (Model.Message != "")
    {
        <p class="alert alert--success">@Model.Message</p>
    }

    <form name="Application" method="post" class="transition-fade-down" enctype="multipart/form-data">
        <fieldset>
            <legend>Personal Information</legend>
            <div class="form-grid">
                <div class="field field--full">
                    <label for="Passport">Passport Photo</label>
                    <input type="file" id="Passport" name="Passport" accept="image/*" required />
                </div>
                <div class="field">
                    <label for="PropertyID">Property ID you're interested in</label>
                    <input type="text" id="PropertyID" name="PropertyID" maxlength="7" />
                </div>
                <div class="field">
                    <label for="Email">Email</label>
                    <input type="email" id="Email" name="Email" />
                </div>
                <div class="field">
                    <label for="FirstName">First Name</label>
                    <input type="text" id="FirstName" name="FirstName" maxlength="30" />
                </div>
                <div class="field">
                    <label for="LastName">Last Name</label>
                    <input type="text" id="LastName" name="LastName" maxlength="30" />
                </div>
                <div class="field">
                    <label for="PhoneNumber">Telephone Number *</label>
                    <input type="tel" id="PhoneNumber" name="PhoneNumber" maxlength="14" />
                </div>
                <div class="field">
                    <label for="DOB">Date of Birth *</label>
                    <input type="date" id="DOB" name="DOB" />
                </div>
                <div class="field">
                    <label for="Password">Password *</label>
                    <input type="password" id="Password" name="Password" maxlength="100" />
                </div>
                <div class="field">
                    <label for="Nationality">Nationality *</label>
                    <input type="text" id="Nationality" name="Nationality" maxlength="20" />
                </div>
                <div class="field">
                    <label for="StateofOrigin">State of Origin</label>
                    <input type="text" id="StateofOrigin" name="StateofOrigin" maxlength="20" />
                </div>
                <div class="field">
                    <label for="LGA">Local Govt. Area</label>
                    <input type="text" id="LGA" name="LGA" maxlength="20" />
                </div>
                <div class="field">
                    <label for="HomeTown">Home Town</label>
                    <input type="text" id="HomeTown" name="HomeTown" maxlength="20" />
                </div>
                <div class="field field--full">
                    <label for="PermanentHomeAddress">Permanent Home Address *</label>
                    <input type="text" id="PermanentHomeAddress" name="PermanentHomeAddress" maxlength="100" />
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Occupation Information</legend>
            <div class="form-grid">
                <div class="field field--full">
                    <label for="Occupation">Occupation *</label>
                    <input type="text" id="Occupation" name="Occupation" />
                </div>
                <div class="field field--full">
                    <label>Are you self-employed? *</label>
                    <div class="radio-row">
                        <input type="radio" id="answer_yes" name="SelfEmployed" value="yes" onclick="showFields()" checked>
                        <label for="answer_yes">Yes</label>
                        <input type="radio" id="answer_no" name="SelfEmployed" value="no" onclick="hideFields()">
                        <label for="answer_no">No</label>
                    </div>
                </div>

                <div id="selfEmployedFields" class="field--full" style="display: none;">
                    <div class="field">
                        <label for="BusinessRegistrationNumber">Business Registration Number</label>
                        <input type="text" id="BusinessRegistrationNumber" name="BusinessRegistrationNumber" maxlength="15" />
                    </div>
                    <div class="field">
                        <label for="CorporateAffairsCertificate">Corporate Affairs Certificate</label>
                        <input type="file" id="CorporateAffairsCertificate" name="CorporateAffairsCertificate" />
                    </div>
                </div>

                <div id="employerFields" class="field--full" style="display: none;">
                    <div class="field">
                        <label for="NameofEmployer">Name of Employer</label>
                        <input type="text" id="NameofEmployer" name="NameofEmployer" maxlength="50" />
                    </div>
                    <div class="field">
                        <label for="AddressOfEmployer">Address of Employer</label>
                        <input type="text" id="AddressOfEmployer" name="AddressOfEmployer" maxlength="100" />
                    </div>
                    <div class="field">
                        <label for="LengthOnJob">How long have you been on the job?</label>
                        <input type="text" id="LengthOnJob" name="LengthOnJob" maxlength="10" />
                    </div>
                    <div class="field">
                        <label for="CurrentPositionHeld">Current Position Held at Job</label>
                        <input type="text" id="CurrentPositionHeld" name="CurrentPositionHeld" maxlength="25" />
                    </div>
                </div>

                <div class="field field--full">
                    <label for="NatureOfJob">Nature of business or Nature of Job</label>
                    <input type="text" id="NatureOfJob" name="NatureOfJob" maxlength="25" />
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Past Rental Information</legend>
            <div class="form-grid">
                <div class="field field--full">
                    <label for="FormerResidenceAddress">Former Residence Address</label>
                    <input type="text" id="FormerResidenceAddress" name="FormerResidenceAddress" maxlength="100" />
                </div>
                <div class="field field--full">
                    <label for="ReasonForMoving">Reasons for moving out of former residence</label>
                    <textarea id="ReasonForMoving" name="ReasonForMoving" maxlength="50"></textarea>
                </div>
                <div class="field">
                    <label for="LengthOfStayAtOldResidence">Years spent at former residence</label>
                    <input type="number" min="0" id="LengthOfStayAtOldResidence" name="LengthOfStayAtOldResidence" maxlength="2" />
                </div>
                <div class="field">
                    <label for="NameOfFormerResidentManager">Former Landlord / Estate Manager</label>
                    <input type="text" id="NameOfFormerResidentManager" name="NameOfFormerResidentManager" maxlength="60" />
                </div>
                <div class="field field--full">
                    <label for="ObjectionsToReasonsForMoving">Any objection to your reason for leaving your former residence?</label>
                    <textarea id="ObjectionsToReasonsForMoving" name="ObjectionsToReasonsForMoving" maxlength="100"></textarea>
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Marital Information</legend>
            <div class="form-grid">
                <div class="field">
                    <label for="MaritalStatus">Marital Status</label>
                    <select id="MaritalStatus" name="MaritalStatus" onchange="toggleSpouseFields(this)">
                        <option value="Single">Single</option>
                        <option value="Married">Married</option>
                        <option value="Divorced">Divorced</option>
                        <option value="Widowed">Widowed</option>
                        <option value="SingleParent">Single Parent</option>
                    </select>
                </div>
                <div class="field">
                    <label for="NumberOfOccupants">Number of Expected Occupants *</label>
                    <input type="number" id="NumberOfOccupants" name="NumberOfOccupants" maxlength="2">
                </div>

                <div id="spouseFields" class="field--full" style="display: none;">
                    <div class="field">
                        <label for="SpouseFirstName">Spouse's First Name</label>
                        <input type="text" id="SpouseFirstName" name="SpouseFirstName" maxlength="30" />
                    </div>
                    <div class="field">
                        <label for="SpouseLastName">Spouse's Last Name</label>
                        <input type="text" id="SpouseLastName" name="SpouseLastName" maxlength="30" />
                    </div>
                    <div class="field">
                        <label for="SpouseOccupation">Spouse's Occupation / Employment</label>
                        <input type="text" id="SpouseOccupation" name="SpouseOccupation" maxlength="25" />
                    </div>
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Next of Kin Information</legend>
            <div class="form-grid">
                <div class="field">
                    <label for="NextOfKinFirstName">Next of Kin First Name *</label>
                    <input type="text" id="NextOfKinFirstName" name="NextOfKinFirstName" maxlength="30" />
                </div>
                <div class="field">
                    <label for="NextOfKinLastName">Next of Kin Last Name *</label>
                    <input type="text" id="NextOfKinLastName" name="NextOfKinLastName" maxlength="30" />
                </div>
                <div class="field">
                    <label for="NextOfKinAddress">Next of Kin Address *</label>
                    <input type="text" id="NextOfKinAddress" name="NextOfKinAddress" maxlength="100" />
                </div>
                <div class="field">
                    <label for="NextOfKinPhoneNumber">Next of Kin Phone Number</label>
                    <input type="text" id="NextOfKinPhoneNumber" name="NextOfKinPhoneNumber" maxlength="14" />
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Guarantor Information</legend>
            <div class="form-grid">
                <div class="field">
                    <label for="Guarantor1FirstName">Guarantor #1 First Name *</label>
                    <input type="text" id="Guarantor1FirstName" name="Guarantor1FirstName" maxlength="30" />
                </div>
                <div class="field">
                    <label for="Guarantor1LastName">Guarantor #1 Last Name</label>
                    <input type="text" id="Guarantor1LastName" name="Guarantor1LastName" maxlength="30" />
                </div>
                <div class="field">
                    <label for="Guarantor1Address">Guarantor #1 Address *</label>
                    <input type="text" id="Guarantor1Address" name="Guarantor1Address" maxlength="100" />
                </div>
                <div class="field">
                    <label for="Guarantor1Occupation">Guarantor #1 Occupation *</label>
                    <input type="text" id="Guarantor1Occupation" name="Guarantor1Occupation" maxlength="25" />
                </div>
                <div class="field">
                    <label for="Guarantor1PhoneNumber">Guarantor #1 Phone Number *</label>
                    <input type="tel" id="Guarantor1PhoneNumber" name="Guarantor1PhoneNumber" maxlength="14" />
                </div>
                <div class="field">
                    <label for="Guarantor1AlternatePhoneNumber">Guarantor #1 Alt. Phone</label>
                    <input type="tel" id="Guarantor1AlternatePhoneNumber" name="Guarantor1AlternatePhoneNumber" maxlength="14" />
                </div>
                <div class="field">
                    <label for="Guarantor2FirstName">Guarantor #2 First Name *</label>
                    <input type="text" id="Guarantor2FirstName" name="Guarantor2FirstName" maxlength="30" />
                </div>
                <div class="field">
                    <label for="Guarantor2LastName">Guarantor #2 Last Name *</label>
                    <input type="text" id="Guarantor2LastName" name="Guarantor2LastName" maxlength="30" />
                </div>
                <div class="field">
                    <label for="Guarantor2Address">Guarantor #2 Address *</label>
                    <input type="text" id="Guarantor2Address" name="Guarantor2Address" maxlength="100" />
                </div>
                <div class="field">
                    <label for="Guarantor2Occupation">Guarantor #2 Occupation *</label>
                    <input type="text" id="Guarantor2Occupation" name="Guarantor2Occupation" maxlength="25" />
                </div>
                <div class="field">
                    <label for="Guarantor2PhoneNumber">Guarantor #2 Phone Number *</label>
                    <input type="tel" id="Guarantor2PhoneNumber" name="Guarantor2PhoneNumber" maxlength="14" />
                </div>
                <div class="field">
                    <label for="Guarantor2AlternatePhoneNumber">Guarantor #2 Alt. Phone</label>
                    <input type="tel" id="Guarantor2AlternatePhoneNumber" name="Guarantor2AlternatePhoneNumber" maxlength="14" />
                </div>
            </div>

            <div class="check-row">
                <input type="checkbox" value="Yes" name="Declaration" id="Declaration" checked />
                <label for="Declaration">
                    I hereby declare that all the information supplied above is true and correct to the best of my
                    knowledge and belief, and I accept to be held liable for any misrepresentation therein. *
                </label>
            </div>

            <input type="text" name="DeleteFlag" value="0" hidden />
            <label for="LeaseFormForSigning" hidden>Lease Form For Signing</label>
            <input type="file" id="LeaseFormForSigning" name="LeaseFormForSigning" hidden />

            <input type="submit" name="Submit" value="Submit Lease Application" class="btn" />
        </fieldset>
    </form>
</div>

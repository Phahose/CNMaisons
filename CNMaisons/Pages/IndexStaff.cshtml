@page
@model CNMaisons.Pages.IndexStaffModel
@{
    ViewData["Title"] = "My Account";
    var isLandlord = Model.Users.Role == "LandLord";
}

<div class="container">
    <div class="profile-card">
        @if (Model.Employee.EmployeeImage != null && Model.Employee.EmployeeImage.Length > 0)
        {
            <img class="avatar" src="data:image;base64,@Convert.ToBase64String(Model.Employee.EmployeeImage)" alt="Employee photo" />
        }
        else
        {
            <img class="avatar" src="~/img/profile_icon.png" alt="" />
        }
        <div>
            <h2>@Model.Employee.FirstName @Model.Employee.LastName</h2>
            <p class="profile-meta"><span class="badge badge--info">@Model.Users.Role</span></p>
            <p class="profile-meta">Employee ID: @Model.Employee.EmployeeId</p>
        </div>
    </div>

    <form method="post" name="StaffAccountForm">
        <h3>Quick actions</h3>
        <div class="action-grid">
            <a href="~/ViewInquiry" class="action-card">View Visit Requests</a>
            <a href="~/ViewPropertyAdmin" class="action-card">View Properties</a>
            <a href="~/UpdateTenant" class="action-card">Update Tenant</a>
            @if (isLandlord)
            {
                <a href="~/ReviewApplication" class="action-card">Review Applications</a>
                <a href="~/AddProperty" class="action-card">Add Property</a>
                <a href="~/ViewTenantbyLandLord" class="action-card">View Tenants</a>
                <a href="~/ViewFinancebyLandlord" class="action-card">Financial Report</a>
            }
        </div>

        @if (isLandlord)
        {
            <p><input type="submit" name="Submit" value="Full Refresh" class="full-refresh"></p>
        }

        <details>
            <summary>Update Password</summary>
            <div class="card__body">
                @if (Model.SuccessMessage != "")
                {
                    <p class="success_message">@Model.SuccessMessage</p>
                }
                <fieldset>
                    <legend>Update Password</legend>
                    <label for="Email">Email</label>
                    <input type="email" id="Email" name="Email" required maxlength="100" value="@Model.Users.Email" />

                    <label for="Password">Password</label>
                    <input type="password" id="Password" name="Password" />

                    <label for="ConfirmPassword">Confirm Password</label>
                    <input type="password" id="ConfirmPassword" name="ConfirmPassword" />

                    @Html.ValidationMessage("PasswordError")
                    @Html.ValidationMessage("ConfirmPasswordError")
                    @Html.ValidationMessage("PasswordMatchError")
                    <input type="submit" name="Submit" class="btn" value="Update">
                </fieldset>
            </div>
        </details>

        @if (Model.IsPasswordChaned == false)
        {
            <div class="update-password transition-fade-down">
                <p>Default password in use — update it to secure your account.</p>
                <label for="Password">New Password</label>
                <input type="password" name="Password" required>
                @Html.ValidationMessage("PasswordError")
                <label for="PasswordConfirm">Re-enter Password</label>
                <input type="password" name="PasswordConfirm" required>
                @Html.ValidationMessage("ConfirmPasswordError")
                @Html.ValidationMessage("PasswordMatchError")
                <input type="submit" name="Submit" value="Update Password" class="btn">
            </div>
        }
    </form>
</div>

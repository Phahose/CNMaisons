@page
@model CNMaisons.Pages.UpdateTenantModel
@{
    ViewData["Title"] = "Update Tenant";
    var emailPattern = new System.Text.RegularExpressions.Regex(@"^[^\s@]+@[^\s@]+\.[^\s@]+$");
    var t = Model.tenantForReview;
}
<script src="~/libraries/jquery/jquery.js"></script>
<script src="~/libraries/jquery-validate/jquery.validate.js"></script>
<script src="~/libraries/jquery-validate-unobtrusive/jquery.validate.unobtrusive.js"></script>


<div class="container">
    <h1 class="section-title">Update tenant</h1>

    <form name="FindPendingApplicationForm" method="post" class="transition-fade-down">
        <fieldset>
            <legend>Find a tenant</legend>
            <div class="field">
                <label for="FindTenantID">Tenant ID</label>
                <input type="text" id="FindTenantID" name="FindTenantID" maxlength="5" />
            </div>
            <input type="submit" name="Submit" value="Find" class="btn" />
            @if (Model.Message != "")
            {
                <p class="alert alert--success" style="margin-top: var(--space-4);">@Model.Message</p>
            }
        </fieldset>
    </form>

    @if (Model.ViewFormNow == true)
    {
        <form name="Application" method="post" class="transition-fade-down" enctype="multipart/form-data">
            <fieldset>
                <legend>Personal Information</legend>
                <div class="form-grid">
                    <div class="field">
                        <label for="TenantID">Tenant ID</label>
                        <input type="text" id="TenantID" name="TenantID" value="@t.TenantID" readonly />
                    </div>
                    <div class="field">
                        <label for="ApprovalStatus">Approval Status</label>
                        <select id="ApprovalStatus" name="ApprovalStatus">
                            <option value="@t.ApprovalStatus">@t.ApprovalStatus</option>
                            <option value="Moved Out">Moved Out</option>
                            <option value="Just Applied">Just Applied</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="PropertyID">Property ID</label>
                        <input type="text" id="PropertyID" name="PropertyID" value="@t.PropertyID" readonly />
                    </div>
                    <div class="field">
                        <label for="FirstName">First Name</label>
                        <input type="text" id="FirstName" name="FirstName" value="@t.FirstName" />
                    </div>
                    <div class="field">
                        <label for="LastName">Last Name</label>
                        <input type="text" id="LastName" name="LastName" value="@t.LastName" />
                    </div>
                    <div class="field">
                        <label for="PhoneNumber">Phone Number</label>
                        <input type="tel" id="PhoneNumber" name="PhoneNumber" value="@t.PhoneNumber" />
                    </div>
                    <div class="field">
                        <label for="Email">Email</label>
                        <input type="email" id="Email" name="Email" value="@t.Email" />
                    </div>
                    <div class="field">
                        <label for="DOB">Date of Birth</label>
                        <input type="date" id="DOB" name="DOB" value="@t.DOB.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="field">
                        <label for="Nationality">Nationality</label>
                        <input type="text" id="Nationality" name="Nationality" value="@t.Nationality" />
                    </div>
                    <div class="field">
                        <label for="StateofOrigin">State of Origin</label>
                        <input type="text" id="StateofOrigin" name="StateofOrigin" value="@t.StateofOrigin" />
                    </div>
                    <div class="field">
                        <label for="LGA">Local Govt. Area</label>
                        <input type="text" id="LGA" name="LGA" value="@t.LGA" />
                    </div>
                    <div class="field">
                        <label for="HomeTown">Home Town</label>
                        <input type="text" id="HomeTown" name="HomeTown" value="@t.HomeTown" />
                    </div>
                    <div class="field field--full">
                        <label for="PermanentHomeAddress">Permanent Home Address</label>
                        <input type="text" id="PermanentHomeAddress" name="PermanentHomeAddress" value="@t.PermanentHomeAddress" />
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Occupation Info</legend>
                <div class="form-grid">
                    <div class="field"><label for="Occupation">Occupation</label><input type="text" id="Occupation" name="Occupation" value="@t.Occupation" /></div>
                    <div class="field"><label for="SelfEmployed">Self Employed</label><input type="text" id="SelfEmployed" name="SelfEmployed" value="@t.SelfEmployed" /></div>
                    <div class="field"><label for="BusinessRegistrationNumber">Business Registration Number</label><input type="text" id="BusinessRegistrationNumber" name="BusinessRegistrationNumber" value="@t.BusinessRegistrationNumber" /></div>
                    <div class="field"><label for="CorporateAffairsCertificate">Corporate Affairs Certificate</label><input type="text" id="CorporateAffairsCertificate" name="CorporateAffairsCertificate" value="@t.CorporateAffairsCertificate" /></div>
                    <div class="field"><label for="NameofEmployer">Name of Employer</label><input type="text" id="NameofEmployer" name="NameofEmployer" value="@t.NameofEmployer" /></div>
                    <div class="field"><label for="AddressOfEmployer">Address Of Employer</label><input type="text" id="AddressOfEmployer" name="AddressOfEmployer" value="@t.AddressOfEmployer" /></div>
                    <div class="field"><label for="LengthOnJob">Length On Job</label><input type="text" id="LengthOnJob" name="LengthOnJob" value="@t.LengthOnJob" /></div>
                    <div class="field"><label for="CurrentPositionHeld">Current Position Held</label><input type="text" id="CurrentPositionHeld" name="CurrentPositionHeld" value="@t.CurrentPositionHeld" /></div>
                    <div class="field"><label for="NatureOfJob">Nature Of Job</label><input type="text" id="NatureOfJob" name="NatureOfJob" value="@t.NatureOfJob" /></div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Past Rental Information</legend>
                <div class="form-grid">
                    <div class="field field--full"><label for="FormerResidenceAddress">Former Residence Address</label><input type="text" id="FormerResidenceAddress" name="FormerResidenceAddress" value="@t.FormerResidenceAddress" /></div>
                    <div class="field field--full"><label for="ReasonForMoving">Reason For Moving</label><input type="text" id="ReasonForMoving" name="ReasonForMoving" value="@t.ReasonForMoving" /></div>
                    <div class="field"><label for="LengthOfStayAtOldResidence">Length Of Stay At Old Residence</label><input type="text" id="LengthOfStayAtOldResidence" name="LengthOfStayAtOldResidence" value="@t.LengthOfStayAtOldResidence" /></div>
                    <div class="field"><label for="NameOfFormerResidentManager">Name Of Former Resident Manager</label><input type="text" id="NameOfFormerResidentManager" name="NameOfFormerResidentManager" value="@t.NameOfFormerResidentManager" /></div>
                    <div class="field field--full"><label for="ObjectionsToReasonsForMoving">Objections To Reasons For Moving</label><input type="text" id="ObjectionsToReasonsForMoving" name="ObjectionsToReasonsForMoving" value="@t.ObjectionsToReasonsForMoving" /></div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Marital Information</legend>
                <div class="form-grid">
                    <div class="field"><label for="MaritalStatus">Marital Status</label><input type="text" id="MaritalStatus" name="MaritalStatus" value="@t.MaritalStatus" /></div>
                    <div class="field"><label for="SpouseFirstName">Spouse First Name</label><input type="text" id="SpouseFirstName" name="SpouseFirstName" value="@t.SpouseFirstName" /></div>
                    <div class="field"><label for="SpouseLastName">Spouse Last Name</label><input type="text" id="SpouseLastName" name="SpouseLastName" value="@t.SpouseLastName" /></div>
                    <div class="field"><label for="SpouseOccupation">Spouse Occupation</label><input type="text" id="SpouseOccupation" name="SpouseOccupation" value="@t.SpouseOccupation" /></div>
                    <div class="field"><label for="NumberOfOccupants">Number Of Occupants</label><input type="text" id="NumberOfOccupants" name="NumberOfOccupants" value="@t.NumberOfOccupants" /></div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Next of Kin Information</legend>
                <div class="form-grid">
                    <div class="field"><label for="NextOfKinFirstName">Next Of Kin First Name</label><input type="text" id="NextOfKinFirstName" name="NextOfKinFirstName" value="@t.NextOfKinFirstName" /></div>
                    <div class="field"><label for="NextOfKinLastName">Next Of Kin Last Name</label><input type="text" id="NextOfKinLastName" name="NextOfKinLastName" value="@t.NextOfKinLastName" /></div>
                    <div class="field"><label for="NextOfKinAddress">Next Of Kin Address</label><input type="text" id="NextOfKinAddress" name="NextOfKinAddress" value="@t.NextOfKinAddress" /></div>
                    <div class="field"><label for="NextOfKinPhoneNumber">Next Of Kin Phone Number</label><input type="text" id="NextOfKinPhoneNumber" name="NextOfKinPhoneNumber" value="@t.NextOfKinPhoneNumber" /></div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Guarantor Information</legend>
                <div class="form-grid">
                    <div class="field"><label for="Guarantor1FirstName">Guarantor1 First Name</label><input type="text" id="Guarantor1FirstName" name="Guarantor1FirstName" value="@t.Guarantor1FirstName" /></div>
                    <div class="field"><label for="Guarantor1LastName">Guarantor1 Last Name</label><input type="text" id="Guarantor1LastName" name="Guarantor1LastName" value="@t.Guarantor1LastName" /></div>
                    <div class="field"><label for="Guarantor1Address">Guarantor1 Address</label><input type="text" id="Guarantor1Address" name="Guarantor1Address" value="@t.Guarantor1Address" /></div>
                    <div class="field"><label for="Guarantor1Occupation">Guarantor1 Occupation</label><input type="text" id="Guarantor1Occupation" name="Guarantor1Occupation" value="@t.Guarantor1Occupation" /></div>
                    <div class="field"><label for="Guarantor1PhoneNumber">Guarantor1 Phone Number</label><input type="text" id="Guarantor1PhoneNumber" name="Guarantor1PhoneNumber" value="@t.Guarantor1PhoneNumber" /></div>
                    <div class="field"><label for="Guarantor1AlternatePhoneNumber">Guarantor1 Alternate Phone Number</label><input type="text" id="Guarantor1AlternatePhoneNumber" name="Guarantor1AlternatePhoneNumber" value="@t.Guarantor1AlternatePhoneNumber" /></div>
                    <div class="field"><label for="Guarantor2FirstName">Guarantor2 First Name</label><input type="text" id="Guarantor2FirstName" name="Guarantor2FirstName" value="@t.Guarantor2FirstName" /></div>
                    <div class="field"><label for="Guarantor2LastName">Guarantor2 Last Name</label><input type="text" id="Guarantor2LastName" name="Guarantor2LastName" value="@t.Guarantor2LastName" /></div>
                    <div class="field"><label for="Guarantor2Address">Guarantor2 Address</label><input type="text" id="Guarantor2Address" name="Guarantor2Address" value="@t.Guarantor2Address" /></div>
                    <div class="field"><label for="Guarantor2Occupation">Guarantor2 Occupation</label><input type="text" id="Guarantor2Occupation" name="Guarantor2Occupation" value="@t.Guarantor2Occupation" /></div>
                    <div class="field"><label for="Guarantor2PhoneNumber">Guarantor2 Phone Number</label><input type="text" id="Guarantor2PhoneNumber" name="Guarantor2PhoneNumber" value="@t.Guarantor2PhoneNumber" /></div>
                    <div class="field"><label for="Guarantor2AlternatePhoneNumber">Guarantor2 Alternate Phone Number</label><input type="text" id="Guarantor2AlternatePhoneNumber" name="Guarantor2AlternatePhoneNumber" value="@t.Guarantor2AlternatePhoneNumber" /></div>
                </div>
                <button type="submit" name="Submit" class="btn" value="Submit">Submit</button>
            </fieldset>
        </form>
    }
</div>

@page
@model CNMaisons.Pages.ViewInquiryModel
@{
    ViewData["Title"] = "Visit Requests";
    var emailPattern = new System.Text.RegularExpressions.Regex(@"^[^\s@]+@[^\s@]+\.[^\s@]+$");
}

<script src="~/libraries/jquery/jquery.js"></script>
<script src="~/libraries/jquery-validate/jquery.validate.js"></script>
<script src="~/libraries/jquery-validate-unobtrusive/jquery.validate.unobtrusive.js"></script>

<script type="text/javascript">
    function validateForm() {
        var visitStatus = document.getElementsByName('VisitStatus')[0].value;
        var submitButtons = document.getElementsByName('Submit');
        for (var i = 0; i < submitButtons.length; i++) {
            submitButtons[i].disabled = (visitStatus === "0");
        }
    }

    function copyData() {
        var args = Array.prototype.slice.call(arguments);
        var inputFields = document.querySelectorAll('input[type="text"]');
        var visitStatusDropdown = document.getElementsByName('VisitStatus')[0];
        for (var i = 0; i < inputFields.length; i++) {
            inputFields[i].value = args[i];
        }
        visitStatusDropdown.disabled = false;
    }
</script>


<div class="container">
    <h1 class="section-title">Visit requests</h1>

    <form name="FindPendingApplicationForm" method="post" class="table-form">
        <div class="table-div">
            <table>
                <thead>
                    <tr>
                        <th>Visit Status</th>
                        <th>Property ID</th>
                        <th>Proposed Date</th>
                        <th>Proposed Time</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Date Recorded</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.OpenVisitList)
                    {
                        <tr>
                            <td class="populating-link"><a href="#" onclick="copyData('@record.PropertyVisitID', '@record.FirstName', '@record.Email')">@record.VisitStatus</a></td>
                            <td>@record.PropertyID</td>
                            <td>@record.ProposedVisitDate.ToString("dd/MM/yyyy")</td>
                            <td>@record.ProposedVisitTime</td>
                            <td>@record.FirstName</td>
                            <td>@record.LastName</td>
                            <td>@record.Email</td>
                            <td>@record.PhoneNumber</td>
                            <td>@record.DateRecorded.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <fieldset>
            <legend>Update a request</legend>
            <p class="text-muted">Click a row's status above to load it here.</p>
            <div class="form-grid">
                <div class="field">
                    <label for="findVisitID">Visit ID</label>
                    <input type="text" id="findVisitID" name="FindVisitID" readonly />
                </div>
                <div class="field">
                    <label>First Name</label>
                    <input type="text" name="FirstName" readonly />
                </div>
                <div class="field">
                    <label>Email</label>
                    <input type="text" name="Email" readonly />
                </div>
                <div class="field">
                    <label for="VisitStatus">Approval Status</label>
                    <select id="VisitStatus" name="VisitStatus" onchange="validateForm()" disabled>
                        <option value="0">--Make your selection--</option>
                        <option value="Confirm Visit">Confirm Visit</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>
            <div class="flex-buttons">
                <button type="submit" name="Submit" class="btn" value="Submit" disabled>Submit Review</button>
                <input type="submit" name="Submit" value="Close" class="btn btn--ghost" />
            </div>
        </fieldset>
    </form>
</div>

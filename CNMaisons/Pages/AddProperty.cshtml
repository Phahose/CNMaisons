@page
@model CNMaisons.Pages.AddPropertyModel
@{
    ViewData["Title"] = "Add Property";
}

<div class="container">
    <h1 class="section-title">Add a new property</h1>

    @if (!string.IsNullOrEmpty(Model.SusccessMessage))
    {
        <p class="alert alert--success">@Model.SusccessMessage</p>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="alert alert--danger">@Model.ErrorMessage</p>
    }

    <form name="AddProperty" method="post" class="property_form transition-fade-down" enctype="multipart/form-data">
        <fieldset>
            <legend>Property details</legend>
            <div class="form-grid">
                <div class="field">
                    <label for="PropertyID">Property ID (format CN00001)</label>
                    <input type="text" id="PropertyID" name="PropertyID" required pattern="[A-Za-z]{2}\d{5}" />
                    @Html.ValidationMessage("PropertyIDError")
                </div>
                <div class="field">
                    <label for="PropertyName">Property Name</label>
                    <input type="text" id="PropertyName" name="PropertyName" />
                    @Html.ValidationMessage("PropertyNameError")
                </div>
                <div class="field">
                    <label for="State">Location (State)</label>
                    <input type="text" id="State" name="State" required />
                    @Html.ValidationMessage("StateError")
                </div>
                <div class="field">
                    <label for="Country">Location (Country)</label>
                    <input type="text" id="Country" name="Country" required />
                    @Html.ValidationMessage("CountryError")
                </div>
                <div class="field field--full">
                    <label for="PropertyAddress">Property Address</label>
                    <input type="text" id="PropertyAddress" name="PropertyAddress" required />
                    @Html.ValidationMessage("PropertyAddressError")
                </div>
                <div class="field">
                    <label for="PropertyType">Property Type</label>
                    <select id="PropertyType" name="PropertyType">
                        <option value="Bungalow">Bungalow</option>
                        <option value="Duplex">Duplex</option>
                        <option value="Single Detatched">Single Detatched</option>
                        <option value="Flat">Flat</option>
                        <option value="Semi-Detached">Semi-Detached</option>
                        <option value="Terraced">Terraced</option>
                        <option value="Cottage">Cottage</option>
                        <option value="Townhouse">Townhouse</option>
                        <option value="Condo">Condo</option>
                        <option value="Mansion">Mansion</option>
                        <option value="Villa">Villa</option>
                        <option value="Cabin">Cabin</option>
                        <option value="Chalet">Chalet</option>
                        <option value="Penthouse">Penthouse</option>
                        <option value="Loft">Loft</option>
                        <option value="Farmhouse">Farmhouse</option>
                        <option value="Mobile Home">Mobile Home</option>
                        <option value="Tiny House">Tiny House</option>
                        <option value="Ranch">Ranch</option>
                        <option value="Multi-family">Multi-family</option>
                        <option value="Row House">Row House</option>
                        <option value="Carriage House">Carriage House</option>
                        <option value="Coach House">Coach House</option>
                        <option value="Beach House">Beach House</option>
                        <option value="Treehouse">Treehouse</option>
                        <option value="Castle">Castle</option>
                    </select>
                    @Html.ValidationMessage("PropertyType")
                </div>
                <div class="field">
                    <label for="RoomNumber">Number of Rooms</label>
                    <input type="number" id="RoomNumber" name="RoomNumber" required />
                    @Html.ValidationMessage("RoomNumberError")
                </div>
                <div class="field">
                    <label for="PropertyPrice">Property Price</label>
                    <input type="number" id="PropertyPrice" name="PropertyPrice" required />
                </div>
                <div class="field field--full">
                    <label for="Description">Property Description</label>
                    <textarea id="Description" name="Description" required maxlength="100"></textarea>
                    @Html.ValidationMessage("Description")
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Images <span class="text-muted">(add at least 4)</span></legend>
            <div class="form-grid">
                <div class="field">
                    <label for="Image1">Image 1</label>
                    <input type="file" id="Image1" name="Image1" required accept=".jpg, .jpeg, .png" />
                    @Html.ValidationMessage("Image1Error")
                </div>
                <div class="field">
                    <label for="Image2">Image 2</label>
                    <input type="file" id="Image2" name="Image2" accept=".jpg, .jpeg, .png" />
                    @Html.ValidationMessage("Image2Error")
                </div>
                <div class="field">
                    <label for="Image3">Image 3</label>
                    <input type="file" id="Image3" name="Image3" accept=".jpg, .jpeg, .png" />
                    @Html.ValidationMessage("Image3Error")
                </div>
                <div class="field">
                    <label for="Image4">Image 4</label>
                    <input type="file" id="Image4" name="Image4" accept=".jpg, .jpeg, .png" />
                    @Html.ValidationMessage("Image4Error")
                </div>
                <div class="field">
                    <label for="Image5">Image 5</label>
                    <input type="file" id="Image5" name="Image5" accept=".jpg, .jpeg, .png" />
                </div>
            </div>
        </fieldset>

        <input type="submit" name="Submit" value="Add Property" class="btn" />
    </form>
</div>

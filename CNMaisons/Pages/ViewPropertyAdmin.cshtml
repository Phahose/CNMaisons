@page
@model CNMaisons.Pages.ViewPropertyAdminModel
@{
    ViewData["Title"] = "Properties";
}

<div class="container">
    <h1 class="section-title">Properties</h1>

    <form method="post" name="PropertyFilter" class="filters">
        <input type="text" name="StateFilter" class="filter-input" placeholder="Filter by state" />
        <input type="text" name="PropertyIDFilter" class="filter-input" placeholder="Property ID" />
        <input type="submit" name="Submit" value="Filter" class="btn filter-btn" />
    </form>

    @for (int i = 0; i < Model.DisplayedPropertyList.Count; i++)
    {
        var prop = Model.DisplayedPropertyList[i];
        <div class="prop-card transition-fade-down">
            <div>
                <img src="data:image;base64,@Convert.ToBase64String(prop.Image1)" alt="@prop.PropertyName" />
            </div>
            <div>
                @if (prop.Occupied == true)
                {
                    <p><span class="badge badge--danger">Occupied</span></p>
                }
                else
                {
                    <p><span class="badge badge--success">Vacant</span></p>
                }
                <p><span class="label">Property ID: </span>@prop.PropertyID</p>
                <p><span class="label">Property Name: </span>@prop.PropertyName</p>
                <p><span class="label">Property Price: </span>@prop.PropertyPrice</p>
                @if (prop.Occupied == true)
                {
                    var tenants = Model.TenantsWithProperties[prop.PropertyID];
                    foreach (var tenant in tenants)
                    {
                        <p><span class="label">Tenant Name: </span>@tenant.FirstName @tenant.LastName</p>
                        <p><span class="label">Tenant Email: </span>@tenant.Email</p>
                        <p><span class="label">Phone Number: </span>@tenant.PhoneNumber</p>
                    }
                }
            </div>
            <div>
                <form method="post" name="PropertyUpdate">
                    <input type="hidden" name="PropertyID" value="@prop.PropertyID">
                    <input type="submit" name="Submit" value="Update Property" class="update-prop-button">
                </form>
                <button type="button" class="delete-prop-button" onclick="showConfirmation('@prop.PropertyID')">Delete Property</button>
            </div>
        </div>
    }

    <form method="post" name="PropertyDelete" class="delConfirmation hideform">
        <h3>Delete property <span id="confirmationPropertyID"></span>?</h3>
        <div class="flex-buttons">
            <input type="hidden" name="DeletedPropertyID" id="deletePropertyID" value="">
            <input type="submit" name="Submit" value="Delete" class="delete-prop-button">
            <button type="button" class="update-prop-button" onclick="hideConfirmation()">Cancel</button>
        </div>
    </form>
</div>

<script>
    function showConfirmation(propertyID) {
        document.getElementById('confirmationPropertyID').innerText = propertyID;
        document.getElementById('deletePropertyID').value = propertyID;
        document.querySelector('.delConfirmation').classList.remove('hideform');
    }
    function hideConfirmation() {
        document.querySelector('.delConfirmation').classList.add('hideform');
    }
</script>

@page
@model CNMaisons.Pages.IndexTenantModel
@{
    ViewData["Title"] = "My Account";
    var approved = Model.Tenant.ApprovalStatus == "Approved";
}

<div class="container">
    <div class="profile-card">
        @if (Model.Tenant.Passport != null && Model.Tenant.Passport.Length > 0)
        {
            <img class="avatar" src="data:image;base64,@Convert.ToBase64String(Model.Tenant.Passport)" alt="Passport photo" />
        }
        else
        {
            <img class="avatar" src="~/img/profile_icon.png" alt="" />
        }
        <div>
            <h2>@Model.Tenant.FirstName @Model.Tenant.LastName</h2>
            <p class="profile-meta">Tenant ID: @Model.Tenant.TenantID</p>
            <p class="profile-meta">
                Application status:
                <span class="badge @(approved ? "badge--success" : "badge--warning")">@Model.Tenant.ApprovalStatus</span>
            </p>
        </div>
    </div>

    <div class="action-grid">
        @if (!approved)
        {
            <a href="~/SignLeaseForm" class="action-card">Sign Lease Form</a>
        }
        else
        {
            <a href="~/AddPayment" class="action-card">Record Rent Payment</a>
            <a href="~/ViewPayment" class="action-card">View Payments</a>
        }
        <a href="~/ViewTenant" class="action-card">View Full Application</a>
    </div>

    <div class="card transition-fade-down">
        <div class="card__body">
            <h3 class="mt-0">Account info</h3>
            <div class="info-list">
                <div class="info-row"><span class="k">Full Name</span><span class="v">@Model.Tenant.FirstName @Model.Tenant.LastName</span></div>
                <div class="info-row"><span class="k">Email</span><span class="v">@Model.Users.Email</span></div>
                <div class="info-row"><span class="k">Phone Number</span><span class="v">@Model.Tenant.PhoneNumber</span></div>
                <div class="info-row"><span class="k">Application Status</span><span class="v">@Model.Tenant.ApprovalStatus</span></div>
                <div class="info-row"><span class="k">Nationality</span><span class="v">@Model.Tenant.Nationality</span></div>
                <div class="info-row"><span class="k">Property ID</span><span class="v">@Model.Tenant.PropertyID</span></div>
            </div>
        </div>
    </div>
</div>

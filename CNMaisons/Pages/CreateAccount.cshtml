@page
@model CNMaisons.Pages.CreateAccountModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container container--narrow">
    <h1 class="section-title">Create a new employee account</h1>

    @foreach (string error in Model.errorMessage)
    {
        <p class="alert alert--danger">@error</p>
    }
    @if (Model.Message != "")
    {
        <p class="alert alert--success">@Model.Message</p>
    }

    <form name="Login" method="post" class="card" enctype="multipart/form-data">
        <fieldset>
            <legend>New user details</legend>

            <label for="UserFirstName">First Name</label>
            <input type="text" id="UserFirstName" name="UserFirstName" required maxlength="30" />

            <label for="LastName">Last Name</label>
            <input type="text" id="LastName" name="LastName" required maxlength="30" />

            <label for="Email">Email</label>
            <input type="email" id="Email" name="Email" required maxlength="100" />

            <label for="Password">Password</label>
            <input type="password" id="Password" name="Password" required />

            <label for="ConfirmPassword">Confirm Password</label>
            <input type="password" id="ConfirmPassword" name="ConfirmPassword" required />

            <label for="EmployeeImage">Employee Image</label>
            <input type="file" id="EmployeeImage" name="EmployeeImage" accept=".jpg, .jpeg, .png" />

            <label for="Role">Select Role</label>
            <select id="Role" name="Role" required>
                <option value="0">-- Make a Selection --</option>
                <option value="LandLord">Landlord</option>
                <option value="Staff">Staff</option>
            </select>

            <button name="Submit" type="submit" class="btn">Create Account</button>
        </fieldset>
    </form>
</div>

@page
@model CNMaisons.Pages.ViewRentsDueModel
@{
    ViewData["Title"] = "Rents Due";
    var currentYear = DateTime.Now.Year;
}

<div class="container">
    <h1 class="section-title">Rents due</h1>

    <form name="ShowFincialRecord" method="get">
        <fieldset>
            <legend>Financial Records Due within 3 Months</legend>
            <div class="table-div">
                <table>
                    <thead>
                        <tr>
                            <th>PaymentID</th><th>TenantID</th><th>PropertyID</th><th>Date of Record</th>
                            <th>Amount Paid</th><th>Payment Start Month</th><th>Payment End Month</th>
                            <th>Payment Start Year</th><th>Months Paid For</th><th>Next Due Month</th>
                            <th>Next Due Year</th><th>Next Due Date</th><th>Date of Payment</th>
                            <th>Method</th><th>Bank</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.FinancialRecordDSueThreeMonthsList)
                        {
                            <tr>
                                <td>@record.PaymentID</td><td>@record.TenantID</td><td>@record.PropertyID</td>
                                <td>@record.DateOfRecord</td><td>@record.AmountPaid</td><td>@record.PaymentStartMonth</td>
                                <td>@record.PaymentEndMonth</td><td>@record.PaymentStartYear</td><td>@record.MonthsPaidFor</td>
                                <td>@record.NextDueMonth</td><td>@record.NextDueYear</td><td>@record.NextDueDate</td>
                                <td>@record.DateOfTenantsPayment</td><td>@record.MethodOfPayment</td><td>@record.TenantPaymentBank</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </fieldset>

        <fieldset>
            <legend>Financial Records Due within 6 Months</legend>
            <div class="table-div">
                <table>
                    <thead>
                        <tr>
                            <th>PaymentID</th><th>TenantID</th><th>PropertyID</th><th>Date of Record</th>
                            <th>Amount Paid</th><th>Payment Start Month</th><th>Payment End Month</th>
                            <th>Payment Start Year</th><th>Months Paid For</th><th>Next Due Month</th>
                            <th>Next Due Year</th><th>Next Due Date</th><th>Date of Payment</th>
                            <th>Method</th><th>Bank</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.FinancialRecordDSueSixMonthsList)
                        {
                            <tr>
                                <td>@record.PaymentID</td><td>@record.TenantID</td><td>@record.PropertyID</td>
                                <td>@record.DateOfRecord</td><td>@record.AmountPaid</td><td>@record.PaymentStartMonth</td>
                                <td>@record.PaymentEndMonth</td><td>@record.PaymentStartYear</td><td>@record.MonthsPaidFor</td>
                                <td>@record.NextDueMonth</td><td>@record.NextDueYear</td><td>@record.NextDueDate</td>
                                <td>@record.DateOfTenantsPayment</td><td>@record.MethodOfPayment</td><td>@record.TenantPaymentBank</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </fieldset>

        <input type="submit" name="Submit" value="Close" class="btn" />
    </form>
</div>

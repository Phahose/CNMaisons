@page
@model CNMaisons.Pages.UpdatePropertyModel
@{
    ViewData["Title"] = "Update Property";
}

<div class="container">
    <h1 class="section-title">Update property</h1>

    @if (!string.IsNullOrEmpty(Model.SucceessMessage))
    {
        <p class="alert alert--success">@Model.SucceessMessage</p>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="alert alert--danger">@Model.ErrorMessage</p>
    }

    <form name="UpdateProperty" method="post" class="property_form transition-fade-down" onsubmit="enableField()" enctype="multipart/form-data">
        <fieldset>
            <legend>Property details</legend>

            <div class="check-row">
                @if (Model.Property.Occupied == true)
                {
                    <input type="checkbox" id="MyCheckbox" name="MyCheckbox" checked />
                }
                else
                {
                    <input type="checkbox" id="MyCheckbox" name="MyCheckbox" />
                }
                <label for="MyCheckbox">Mark as occupied</label>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label for="PropertyID">Property ID (format CN00001)</label>
                    <input type="text" id="PropertyID" name="PropertyID" required pattern="[A-Za-z]{2}\d{5}" value="@Model.Property.PropertyID" disabled />
                    @Html.ValidationMessage("PropertyIDError")
                </div>
                <div class="field">
                    <label for="PropertyName">Property Name</label>
                    <input type="text" id="PropertyName" name="PropertyName" value="@Model.Property.PropertyName" />
                    @Html.ValidationMessage("PropertyNameError")
                </div>
                <div class="field">
                    <label for="State">Location (State)</label>
                    <input type="text" id="State" name="State" required value="@Model.Property.PropertyLocationState" />
                    @Html.ValidationMessage("StateError")
                </div>
                <div class="field">
                    <label for="Country">Location (Country)</label>
                    <input type="text" id="Country" name="Country" required value="@Model.Property.PropertyLocationCountry" />
                    @Html.ValidationMessage("CountryError")
                </div>
                <div class="field field--full">
                    <label for="PropertyAddress">Property Address</label>
                    <input type="text" id="PropertyAddress" name="PropertyAddress" required value="@Model.Property.PropertyAddress" />
                    @Html.ValidationMessage("PropertyAddressError")
                </div>
                <div class="field">
                    <label for="PropertyType">Property Type</label>
                    <select id="PropertyType" name="PropertyType">
                        @foreach (var type in new[] { "Bungalow","Duplex","Single Detatched","Flat","Semi-Detached","Terraced","Cottage","Townhouse","Condo","Mansion","Villa","Cabin","Chalet","Penthouse","Loft","Farmhouse","Mobile Home","Tiny House","Ranch","Multi-family","Row House","Carriage House","Coach House","Beach House","Treehouse","Castle" })
                        {
                            <option value="@type" selected="@(Model.Property.PropertyType == type)">@type</option>
                        }
                    </select>
                    @Html.ValidationMessage("PropertyType")
                </div>
                <div class="field">
                    <label for="RoomNumber">Number of Rooms</label>
                    <input type="number" id="RoomNumber" name="RoomNumber" required value="@Model.Property.NumberOfRooms" />
                    @Html.ValidationMessage("RoomNumberError")
                </div>
                <div class="field">
                    <label for="PropertyPrice">Property Price</label>
                    <input type="number" id="PropertyPrice" name="PropertyPrice" required value="@Model.Property.PropertyPrice" />
                </div>
                <div class="field field--full">
                    <label for="Description">Property Description</label>
                    <textarea id="Description" name="Description" required>@Model.Property.PropertyDescription</textarea>
                    @Html.ValidationMessage("Description")
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Images</legend>
            <div class="form-grid">
                @{
                    var images = new (string name, byte[] data)[]
                    {
                        ("Image1", Model.Property.Image1),
                        ("Image2", Model.Property.Image2),
                        ("Image3", Model.Property.Image3),
                        ("Image4", Model.Property.Image4),
                        ("Image5", Model.Property.Image5),
                    };
                }
                @for (int i = 0; i < images.Length; i++)
                {
                    var img = images[i];
                    <div class="field">
                        <label for="@img.name">@($"Image {i + 1}")</label>
                        <div class="img-row">
                            @if (img.data != null && img.data.Length > 0)
                            {
                                <img src="data:image;base64,@Convert.ToBase64String(img.data)" alt="Property image @(i + 1)" />
                            }
                            else
                            {
                                <img src="~/img/no-image.jpg" alt="No image" />
                            }
                        </div>
                        <input type="file" id="@img.name" name="@img.name" accept=".jpg, .jpeg, .png" />
                        @Html.ValidationMessage($"{img.name}Error")
                    </div>
                }
            </div>
        </fieldset>

        <input type="submit" name="Submit" value="Update Property" class="btn" />
    </form>
</div>

<script>
    function enableField() {
        document.getElementsByName("PropertyID")[0].disabled = false;
    }
</script>

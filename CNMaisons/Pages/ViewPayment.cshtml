@page
@model CNMaisons.Pages.ViewPaymentModel
@{
    ViewData["Title"] = "View Payment";
}
<script src="~/libraries/jquery/jquery.js"></script>
<script src="~/libraries/jquery-validate/jquery.validate.js"></script>
<script src="~/libraries/jquery-validate-unobtrusive/jquery.validate.unobtrusive.js"></script>


<div class="container">
    <h1 class="section-title">Payments</h1>

    @if (Model.ViewPage != true)
    {
        <form name="ViewPayment" method="post" class="transition-fade-down">
            <fieldset>
                <legend>Find payments</legend>
                <div class="form-grid">
                    <div class="field">
                        <label for="FindTenantID">Tenant ID</label>
                        <input type="text" id="FindTenantID" name="FindTenantID" required value="@Model.aTenant.TenantID" />
                    </div>
                    <div class="field">
                        <label for="FindStartDate">Start Date</label>
                        <input type="date" id="FindStartDate" name="FindStartDate" required value='@(DateTime.Today.ToString("yyyy-MM-dd"))' max='@(DateTime.Today.ToString("yyyy-MM-dd"))' />
                    </div>
                    <div class="field">
                        <label for="FindEndDate">End Date</label>
                        <input type="date" id="FindEndDate" name="FindEndDate" required value='@(DateTime.Today.ToString("yyyy-MM-dd"))' max='@(DateTime.Today.ToString("yyyy-MM-dd"))' />
                    </div>
                </div>
                <input type="submit" name="Submit" value="Find" class="btn" />
            </fieldset>
        </form>
    }

    @if (Model.ViewPage == true)
    {
        @if (Model.PaymentList.Count > 0)
        {
            <form name="ShowPayment" method="post" class="transition-fade-down">
                <div class="table-div">
                    <table>
                        <thead>
                            <tr>
                                <th>Tenant ID</th>
                                <th>Property ID</th>
                                <th>Date of Record</th>
                                <th>Amount Paid</th>
                                <th>Pay Period</th>
                                <th>Next Due Date</th>
                                <th>Date of Payment</th>
                                <th>Method</th>
                                <th>Bank</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.PaymentList)
                            {
                                <tr>
                                    <td>@record.TenantID</td>
                                    <td>@record.PropertyID</td>
                                    <td>@record.DateOfRecord.ToString("dd MMM yyyy")</td>
                                    <td>@record.AmountPaid.ToString("0.00")</td>
                                    <td>@record.PaymentStartMonth (@record.PaymentStartYear) - @record.PaymentEndMonth</td>
                                    <td>@record.NextDueDate.ToString("dd MMM yyyy")</td>
                                    <td>@record.DateOfTenantsPayment.ToString("dd MMM yyyy")</td>
                                    <td>@record.MethodOfPayment</td>
                                    <td>@record.TenantPaymentBank</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="flex-buttons">
                    <input type="submit" name="Submit" value="Find" class="btn" />
                    <input type="submit" name="Submit" value="Refresh" class="btn btn--secondary" />
                    <input type="submit" name="Submit" value="Close" class="btn btn--ghost" />
                </div>
            </form>
        }
        else
        {
            <form name="ShowPayment" method="post">
                <p class="empty-state">There are no payments recorded for the specified dates.</p>
                <input type="submit" name="Submit" value="Close" class="btn" />
            </form>
        }
    }
</div>

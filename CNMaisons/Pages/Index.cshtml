@page
@model CNMaisons.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero__inner overlay-content transition-fade-down">
        <h1 class="hero__title">Find a home that fits your life</h1>
        <p class="hero__lead">
            At CN Maisons we connect people with comfortable, well-managed homes to rent —
            making the journey to your perfect space seamless and stress-free.
        </p>
        <form method="post" name="SearchForm" class="search">
            <input type="hidden" name="FormType" value="SearchForm">
            <input type="text" name="StateFilter" class="searchfield" placeholder="Search by state…" aria-label="Search by state" />
            <input type="submit" name="Search" value="Search" class="search_button" />
        </form>
    </div>
</section>

<section class="properties">
    <h2 class="prop_head">Available properties</h2>
    <div class="cards transition-fade">
        @foreach (var property in Model.DisplayedPropertyList)
        {
            <article class="property-card">
                <img src="data:image;base64,@Convert.ToBase64String(property.Image1)" alt="@property.PropertyName" />
                <div class="property-details">
                    <h3 class="property-title">@property.PropertyName</h3>
                    <p class="property-location">@property.PropertyAddress</p>
                    <p class="property-location">Property ID: @property.PropertyID</p>
                    <p class="property-description">@property.PropertyDescription</p>
                    <div class="property-price">@property.PropertyPrice / Year</div>
                    <form method="post" name="InfoForm">
                        <input type="hidden" name="FormType" value="InfoForm">
                        <input type="hidden" name="PropertyID" value="@property.PropertyID">
                        <input type="submit" name="Submit" value="View Details" class="btn" />
                    </form>
                </div>
            </article>
        }
        @if (Model.DisplayedPropertyList.Count < 1)
        {
            <p class="empty-state">@(string.IsNullOrEmpty(Model.ErrorMessage) ? "No properties are available right now." : Model.ErrorMessage)</p>
        }
    </div>
</section>

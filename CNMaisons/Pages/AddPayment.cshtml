@page
@model CNMaisons.Pages.AddPaymentModel
@{
    ViewData["Title"] = "Record A Payment";
    var currentYear = DateTime.Now.Year;
}

<script src="~/libraries/jquery/jquery.js"></script>
<script src="~/libraries/jquery-validate/jquery.validate.js"></script>
<script src="~/libraries/jquery-validate-unobtrusive/jquery.validate.unobtrusive.js"></script>


<div class="container">
    <h1 class="section-title">Record a payment</h1>

    <form name="AddPayment" method="post" class="transition-fade-down">
        @foreach (var error in Model.errorMessage)
        {
            @if (error != null)
            {
                <p class="alert alert--danger">@error</p>
            }
        }
        @if (Model.Message != "")
        {
            <p class="alert alert--success">@Model.Message</p>
        }

        <fieldset>
            <legend>Payment details</legend>
            <div class="form-grid">
                <div class="field">
                    <label for="TenantID">Tenant ID</label>
                    <input type="text" id="TenantID" name="TenantID" maxlength="5" required oninput="this.value = this.value.toUpperCase();" value="@Model.tenantForPayment.TenantID" readonly />
                </div>
                <div class="field">
                    <label for="PropertyID">Property ID</label>
                    <input type="text" id="PropertyID" name="PropertyID" maxlength="7" required oninput="this.value = this.value.toUpperCase();" value="@Model.tenantForPayment.PropertyID" readonly />
                </div>
                <div class="field">
                    <label for="AmountPaid">Amount Paid</label>
                    <input type="number" id="AmountPaid" name="AmountPaid" required onchange="calculatePaymentEndMonth()" />
                </div>

                <input hidden type="date" name="DateOfTenantsPayment" required value='@(DateTime.Today.ToString("yyyy-MM-dd"))' max='@(DateTime.Today.ToString("yyyy-MM-dd"))' />

                <div class="field">
                    <label for="MethodOfPayment">Method Of Payment</label>
                    <select id="MethodOfPayment" name="MethodOfPayment" required>
                        <option value="">Select Method</option>
                        <option value="E Transfer">E Transfer</option>
                        <option value="Cheque">Cheque</option>
                        <option value="Cash">Cash</option>
                    </select>
                </div>
                <div class="field">
                    <label for="TenantPaymentBank">Tenant Payment Bank</label>
                    <select id="TenantPaymentBank" name="TenantPaymentBank" required>
                        <option value="">Select Bank</option>
                        <option value="Access Bank">Access Bank</option>
                        <option value="Citibank">Citibank</option>
                        <option value="Diamond Bank">Diamond Bank</option>
                        <option value="Ecobank Nigeria">Ecobank Nigeria</option>
                        <option value="Fidelity Bank Nigeria">Fidelity Bank Nigeria</option>
                        <option value="First Bank of Nigeria">First Bank of Nigeria</option>
                        <option value="First City Monument Bank">First City Monument Bank (FCMB)</option>
                        <option value="Guaranty Trust Bank">Guaranty Trust Bank (GTB)</option>
                        <option value="Heritage Bank Plc">Heritage Bank Plc</option>
                        <option value="Keystone Bank Limited">Keystone Bank Limited</option>
                        <option value="Polaris Bank">Polaris Bank</option>
                        <option value="Stanbic IBTC Bank Nigeria Limited">Stanbic IBTC Bank Nigeria Limited</option>
                        <option value="Standard Chartered Bank">Standard Chartered Bank</option>
                        <option value="Sterling Bank">Sterling Bank</option>
                        <option value="Union Bank of Nigeria">Union Bank of Nigeria</option>
                        <option value="United Bank for Africa">United Bank for Africa (UBA)</option>
                        <option value="Unity Bank Plc">Unity Bank Plc</option>
                        <option value="Wema Bank">Wema Bank</option>
                        <option value="Zenith Bank">Zenith Bank</option>
                    </select>
                </div>
                <div class="field">
                    <label for="MonthsPaidFor">Months Paid For</label>
                    <select id="MonthsPaidFor" name="MonthsPaidFor" required onchange="calculatePaymentEndMonth(document.getElementById('PaymentStartMonth').value)">
                        <option value="12">12</option>
                        <option value="6">6</option>
                    </select>
                </div>
                <div class="field">
                    <label for="PaymentStartMonth">Payment Start Month</label>
                    <select id="PaymentStartMonth" name="PaymentStartMonth" required onchange="calculatePaymentEndMonth(this.value)">
                        <option value="">Select Month</option>
                        <option value="JAN">JAN</option>
                        <option value="FEB">FEB</option>
                        <option value="MAR">MAR</option>
                        <option value="APR">APR</option>
                        <option value="MAY">MAY</option>
                        <option value="JUN">JUN</option>
                        <option value="JUL">JUL</option>
                        <option value="AUG">AUG</option>
                        <option value="SEP">SEP</option>
                        <option value="OCT">OCT</option>
                        <option value="NOV">NOV</option>
                        <option value="DEC">DEC</option>
                    </select>
                </div>
                <div class="field">
                    <label for="PaymentStartYearSelect">Payment Start Year</label>
                    <select id="PaymentStartYearSelect" name="PaymentStartYear" required onchange="computeNextDueYear()">
                        <option value="">Select Year</option>
                        @for (int year = currentYear; year <= (currentYear + 2); year++)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="PaymentEndMonth">Payment End Month</label>
                    <input type="text" id="PaymentEndMonth" name="PaymentEndMonth" required readonly onchange="computeNextDueDate()" />
                </div>
                <div class="field">
                    <label for="NextDueMonth">Next Due Month</label>
                    <input type="text" id="NextDueMonth" name="NextDueMonth" required readonly onchange="computeNextDueDate()" />
                </div>
                <div class="field">
                    <label for="NextDueYear">Next Due Year</label>
                    <input type="number" id="NextDueYear" name="NextDueYear" readonly required onchange="computeNextDueDate()" />
                </div>
                <div class="field">
                    <label for="NextDueDate">Next Due Date</label>
                    <input type="date" id="NextDueDate" name="NextDueDate" required readonly />
                </div>
            </div>
            <input type="submit" name="Submit" value="Add Payment" class="btn" />
        </fieldset>
    </form>
</div>

<script type="text/javascript">
    function calculatePaymentEndMonth() {
        const month12b = ["DEC", "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV"];
        const month12c = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
        const month12a = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
        const month6a = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
        const month6b = ["JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC", "JAN", "FEB", "MAR", "APR", "MAY"];
        const month6c = ["JUL", "AUG", "SEP", "OCT", "NOV", "DEC", "JAN", "FEB", "MAR", "APR", "MAY", "JUN"];

        const monthsPaidFor = parseInt(document.getElementById("MonthsPaidFor").value);
        const paymentStartMonthValue = document.getElementById("PaymentStartMonth").value.toUpperCase();
        const paymentEndMonthInput = document.getElementById("PaymentEndMonth");
        const NextDueMonthInput = document.getElementById("NextDueMonth");

        if (monthsPaidFor === 12) {
            const index = month12a.indexOf(paymentStartMonthValue);
            if (index !== -1) { paymentEndMonthInput.value = month12b[index]; NextDueMonthInput.value = month12c[index]; }
        } else if (monthsPaidFor === 6) {
            const index = month6a.indexOf(paymentStartMonthValue);
            if (index !== -1) { paymentEndMonthInput.value = month6b[index]; NextDueMonthInput.value = month6c[index]; }
        }
        computeNextDueDate();
        return '';
    }

    function computeNextDueYear() {
        var monthsPaidFor = parseInt(document.getElementById("MonthsPaidFor").value);
        var paymentStartMonth = document.getElementById("PaymentStartMonth").value.toUpperCase();
        var paymentStartYear = parseInt(document.getElementById("PaymentStartYearSelect").value);
        var nextDueYearInput = document.getElementById("NextDueYear");
        var nextDueYear;

        if (monthsPaidFor === 12) {
            nextDueYear = paymentStartYear + 1;
        } else if (monthsPaidFor === 6 && ["JAN","FEB","MAR","APR","MAY","JUNE"].includes(paymentStartMonth)) {
            nextDueYear = paymentStartYear;
        } else {
            nextDueYear = paymentStartYear + 1;
        }
        nextDueYearInput.value = nextDueYear;
        computeNextDueDate();
        calculatePaymentEndMonth();
    }

    function computeNextDueDate() {
        const month12 = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
        var NextDueDateInput = document.getElementById("NextDueDate");
        var NextDueMonth = document.getElementById("NextDueMonth").value.toUpperCase();
        var nextDueYear = parseInt(document.getElementById("NextDueYear").value);
        var NextDueMonthNumber = month12.indexOf(NextDueMonth) + 1;
        NextDueDateInput.value = nextDueYear + '-' + ('0' + NextDueMonthNumber).slice(-2) + '-01';
    }

    // Initialise defaults once the DOM is ready (guards prevent the null-ref crash the old code had).
    document.addEventListener('DOMContentLoaded', function () {
        var yearSelect = document.getElementById("PaymentStartYearSelect");
        if (yearSelect) yearSelect.value = new Date().getFullYear();
    });
</script>

@page
@model CNMaisons.Pages.ReviewApplicationModel
@using System.Security.Claims

@{
    ViewData["Title"] = "Review Application";
    var emailPattern = new System.Text.RegularExpressions.Regex(@"^[^\s@]+@[^\s@]+\.[^\s@]+$");
    var userRole = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}

<script src="~/libraries/jquery/jquery.js"></script>
<script src="~/libraries/jquery-validate/jquery.validate.js"></script>
<script src="~/libraries/jquery-validate-unobtrusive/jquery.validate.unobtrusive.js"></script>

<script type="text/javascript">
    function copyTenantID(tenantID, email) {
        document.querySelector('input[name="FindTenantID"]').value = tenantID;
        document.querySelector('input[name="FindEmail"]').value = email;
    }

    function validateForm() {
        var approvalStatus = document.getElementsByName('ApprovalStatus')[0].value;
        var leaseFormFile = document.getElementsByName('LeaseFormForSigning')[0];
        var submitButtons = document.getElementsByName('Submit');

        if (approvalStatus !== "0" && leaseFormFile.files.length > 0) {
            submitButtons.forEach(function (button) { button.disabled = false; });
        } else {
            submitButtons.forEach(function (button) { button.disabled = true; });
        }

        if (approvalStatus === "Approved" || approvalStatus === "Rejected") {
            leaseFormFile.disabled = true;
            submitButtons.forEach(function (button) { button.disabled = false; });
        } else {
            leaseFormFile.disabled = false;
        }
    }

    // Only wire these up when the review form is present on the page.
    document.addEventListener('DOMContentLoaded', function () {
        var approvalEl = document.getElementsByName('ApprovalStatus')[0];
        var leaseEl = document.getElementsByName('LeaseFormForSigning')[0];
        if (approvalEl) approvalEl.addEventListener('change', validateForm);
        if (leaseEl) leaseEl.addEventListener('change', validateForm);
    });
</script>


<div class="container">
    @if (Model.ViewFormNow == false)
    {
        <h1 class="section-title">Review lease applications</h1>
        <form name="FindPendingApplicationForm" method="post" class="table-form">
            <div class="table-div">
                <table>
                    <thead>
                        <tr>
                            <th>Tenant ID</th>
                            <th>Property ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Approval Status</th>
                            <th>Lease Form</th>
                            <th>Signed Form</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.ListOfTenantsPendingReview)
                        {
                            <tr>
                                <td class="populating-link">
                                    <a href="#" onclick="copyTenantID('@record.TenantID', '@record.Email')">@record.TenantID</a>
                                </td>
                                <td>@record.PropertyID</td>
                                <td>@record.FirstName</td>
                                <td>@record.LastName</td>
                                <td>@record.ApprovalStatus</td>
                                <td>
                                    @if (record.LeaseFormForSigning != null && record.LeaseFormForSigning.Length > 0)
                                    {
                                        string base64Document = Convert.ToBase64String(record.LeaseFormForSigning!);
                                        <a href="data:application/octet-stream;base64,@base64Document" download="@record.FirstName Tenancy Contract">Download Lease Form</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No Lease Form</span>
                                    }
                                </td>
                                <td>
                                    @if (record.YourSignedForm != null && record.YourSignedForm.Length > 0)
                                    {
                                        string base64Document = Convert.ToBase64String(record.YourSignedForm!);
                                        <a href="data:application/octet-stream;base64,@base64Document" download="@record.FirstName Signed Tenancy Contract">Download Signed Form</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No Signed Form</span>
                                    }
                                </td>
                                <td>@record.Email</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <fieldset>
                <legend>Find an application</legend>
                <div class="form-grid">
                    <div class="field">
                        <label for="FindTenantID">Tenant ID</label>
                        <input type="text" id="FindTenantID" name="FindTenantID" readonly />
                    </div>
                    <div class="field">
                        <label for="FindEmail">Email</label>
                        <input type="text" id="FindEmail" name="FindEmail" readonly />
                    </div>
                </div>
                <div class="flex-buttons">
                    <input type="submit" name="Submit" value="Find" class="btn" />
                    <input type="submit" name="Submit" value="Refresh" class="btn btn--secondary" />
                    <input type="submit" name="Submit" value="Close" class="btn btn--ghost" />
                </div>
            </fieldset>
        </form>
    }

    @if (Model.ViewFormNow == true)
    {
        <h1 class="section-title">Application review</h1>
        <form name="Application" method="post" class="transition-fade-down" enctype="multipart/form-data" onsubmit="return validateForm()">
            <p class="text-muted" style="font-style: italic;">@Model.Message</p>
            <fieldset>
                <legend>Declaration, Signature, and Approval</legend>
                <div class="form-grid">
                    <div class="field">
                        <label for="ApprovalStatus">Approval Status</label>
                        <select id="ApprovalStatus" name="ApprovalStatus" onchange="validateForm()">
                            <option value="0" @(Model.tenantForReview.ApprovalStatus == "--Make your selection--" ? "selected" : "")>--Make your selection--</option>
                            <option value="Awaiting Signature" @(Model.tenantForReview.ApprovalStatus == "Awaiting Signature" ? "selected" : "")>Awaiting Signature</option>
                            <option value="Approved" @(Model.tenantForReview.ApprovalStatus == "Approved" ? "selected" : "")>Approved</option>
                            <option value="Rejected" @(Model.tenantForReview.ApprovalStatus == "Rejected" ? "selected" : "")>Rejected</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="LeaseFormForSigning">Attach Lease Form For Signing</label>
                        <input type="file" id="LeaseFormForSigning" name="LeaseFormForSigning" accept="application/pdf" onchange="validateForm()" />
                    </div>
                </div>
                <p class="text-muted" style="font-style: italic;">@Model.MessageForFile</p>
                <button type="submit" name="Submit" class="btn" value="Submit Review" disabled>Submit Review</button>
            </fieldset>

            <details>
                <summary>Personal Information</summary>
                <div class="tenant-info">
                    <div class="info-item"><span class="label">First Name:</span> <span class="value">@Model.tenantForReview.FirstName</span></div>
                    <div class="info-item"><span class="label">Last Name:</span> <span class="value">@Model.tenantForReview.LastName</span></div>
                    <div class="info-item"><span class="label">Phone Number:</span> <span class="value">@Model.tenantForReview.PhoneNumber</span></div>
                    <div class="info-item"><span class="label">Email:</span> <span class="value">@Model.tenantForReview.Email</span></div>
                    <div class="info-item"><span class="label">Date of Birth:</span> <span class="value">@Model.tenantForReview.DOB.ToString("dd MMMM, yyyy.")</span></div>
                    <div class="info-item"><span class="label">Nationality:</span> <span class="value">@Model.tenantForReview.Nationality</span></div>
                    <div class="info-item"><span class="label">State of Origin:</span> <span class="value">@Model.tenantForReview.StateofOrigin</span></div>
                    <div class="info-item"><span class="label">Local Govt. Area:</span> <span class="value">@Model.tenantForReview.LGA</span></div>
                    <div class="info-item"><span class="label">Home Town:</span> <span class="value">@Model.tenantForReview.HomeTown</span></div>
                    <div class="info-item"><span class="label">Permanent Home Add:</span> <span class="value">@Model.tenantForReview.PermanentHomeAddress</span></div>
                </div>
            </details>
            <details>
                <summary>Occupation Info</summary>
                <div class="tenant-info">
                    <div class="info-item"><span class="label">Occupation:</span> <span class="value">@Model.tenantForReview.Occupation</span></div>
                    <div class="info-item"><span class="label">Self Employed:</span> <span class="value">@Model.tenantForReview.SelfEmployed</span></div>
                    <div class="info-item"><span class="label">Business Registration Number:</span> <span class="value">@Model.tenantForReview.BusinessRegistrationNumber</span></div>
                    <div class="info-item"><span class="label">Corporate Affairs Certificate:</span> <span class="value">@Model.tenantForReview.CorporateAffairsCertificate</span></div>
                    <div class="info-item"><span class="label">Name of Employer:</span> <span class="value">@Model.tenantForReview.NameofEmployer</span></div>
                    <div class="info-item"><span class="label">Address Of Employer:</span> <span class="value">@Model.tenantForReview.AddressOfEmployer</span></div>
                    <div class="info-item"><span class="label">Length On Job:</span> <span class="value">@Model.tenantForReview.LengthOnJob</span></div>
                    <div class="info-item"><span class="label">Current Position Held:</span> <span class="value">@Model.tenantForReview.CurrentPositionHeld</span></div>
                    <div class="info-item"><span class="label">Nature Of Job:</span> <span class="value">@Model.tenantForReview.NatureOfJob</span></div>
                </div>
            </details>
            <details>
                <summary>Past Rental Information</summary>
                <div class="tenant-info">
                    <div class="info-item"><span class="label">Former Residence Address:</span> <span class="value">@Model.tenantForReview.FormerResidenceAddress</span></div>
                    <div class="info-item"><span class="label">Reason For Moving:</span> <span class="value">@Model.tenantForReview.ReasonForMoving</span></div>
                    <div class="info-item"><span class="label">Length Of Stay At Old Residence:</span> <span class="value">@Model.tenantForReview.LengthOfStayAtOldResidence</span></div>
                    <div class="info-item"><span class="label">Name Of Former Resident Manager:</span> <span class="value">@Model.tenantForReview.NameOfFormerResidentManager</span></div>
                    <div class="info-item"><span class="label">Objections To Reasons For Moving:</span> <span class="value">@Model.tenantForReview.ObjectionsToReasonsForMoving</span></div>
                </div>
            </details>
            <details>
                <summary>Marital Information</summary>
                <div class="tenant-info">
                    <div class="info-item"><span class="label">Marital Status:</span> <span class="value">@Model.tenantForReview.MaritalStatus</span></div>
                    <div class="info-item"><span class="label">Spouse First Name:</span> <span class="value">@Model.tenantForReview.SpouseFirstName</span></div>
                    <div class="info-item"><span class="label">Spouse Last Name:</span> <span class="value">@Model.tenantForReview.SpouseLastName</span></div>
                    <div class="info-item"><span class="label">Spouse Occupation:</span> <span class="value">@Model.tenantForReview.SpouseOccupation</span></div>
                    <div class="info-item"><span class="label">Number Of Occupants:</span> <span class="value">@Model.tenantForReview.NumberOfOccupants</span></div>
                </div>
            </details>
            <details>
                <summary>Next of Kin Information</summary>
                <div class="tenant-info">
                    <div class="info-item"><span class="label">Next Of Kin First Name:</span> <span class="value">@Model.tenantForReview.NextOfKinFirstName</span></div>
                    <div class="info-item"><span class="label">Next Of Kin Last Name:</span> <span class="value">@Model.tenantForReview.NextOfKinLastName</span></div>
                    <div class="info-item"><span class="label">Next Of Kin Address:</span> <span class="value">@Model.tenantForReview.NextOfKinAddress</span></div>
                    <div class="info-item"><span class="label">Next Of Kin Phone Number:</span> <span class="value">@Model.tenantForReview.NextOfKinPhoneNumber</span></div>
                </div>
            </details>
            <details>
                <summary>Guarantor Information</summary>
                <div class="tenant-info">
                    <div class="info-item"><span class="label">Guarantor1 First Name:</span> <span class="value">@Model.tenantForReview.Guarantor1FirstName</span></div>
                    <div class="info-item"><span class="label">Guarantor1 Last Name:</span> <span class="value">@Model.tenantForReview.Guarantor1LastName</span></div>
                    <div class="info-item"><span class="label">Guarantor1 Address:</span> <span class="value">@Model.tenantForReview.Guarantor1Address</span></div>
                    <div class="info-item"><span class="label">Guarantor1 Occupation:</span> <span class="value">@Model.tenantForReview.Guarantor1Occupation</span></div>
                    <div class="info-item"><span class="label">Guarantor1 Phone Number:</span> <span class="value">@Model.tenantForReview.Guarantor1PhoneNumber</span></div>
                    <div class="info-item"><span class="label">Guarantor1 Alternate Phone Number:</span> <span class="value">@Model.tenantForReview.Guarantor1AlternatePhoneNumber</span></div>
                    <div class="info-item"><span class="label">Guarantor2 First Name:</span> <span class="value">@Model.tenantForReview.Guarantor2FirstName</span></div>
                    <div class="info-item"><span class="label">Guarantor2 Last Name:</span> <span class="value">@Model.tenantForReview.Guarantor2LastName</span></div>
                    <div class="info-item"><span class="label">Guarantor2 Address:</span> <span class="value">@Model.tenantForReview.Guarantor2Address</span></div>
                    <div class="info-item"><span class="label">Guarantor2 Occupation:</span> <span class="value">@Model.tenantForReview.Guarantor2Occupation</span></div>
                    <div class="info-item"><span class="label">Guarantor2 Phone Number:</span> <span class="value">@Model.tenantForReview.Guarantor2PhoneNumber</span></div>
                    <div class="info-item"><span class="label">Guarantor2 Alternate Phone Number:</span> <span class="value">@Model.tenantForReview.Guarantor2AlternatePhoneNumber</span></div>
                </div>
            </details>
        </form>
    }
</div>
